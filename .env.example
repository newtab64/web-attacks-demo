# Security Mode: 'secure' (default) or 'vulnerable'
SECURITY_MODE=secure

# Server Port
PORT=3000

# Attacker Server Port
ATTACKER_PORT=4000

# Session Secret (random 32+ char string in production)
SESSION_SECRET=dev-lecture-secret-key-super-secure-32-chars

# Show mode indicator badge in bottom corner (0 = off, 1 = on)
SHOW_MODE_BADGE=0
