{
  "name": "web-attacks-demo",
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": "^22.0.0"
  },
  "scripts": {
    "build": "npm run build:css && tsc",
    "build:css": "tailwindcss -i ./styles/input.css -o ./public/css/style.css --minify",
    "check": "tsc --noEmit && eslint --max-warnings 0 && prettier --check . && vitest run",
    "dev": "npm run build:css && tsx watch src/server.ts",
    "format": "prettier --write .",
    "lint": "eslint --max-warnings 0",
    "seed": "tsx src/core/db/seed.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "attacker": "tsx attacker/server.ts",
    "screenshot": "tsx scripts/screenshot.ts",
    "screenshots": "tsx scripts/screenshot.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "better-sqlite3": "11.8.1",
    "cookie-session": "2.1.1",
    "ejs": "3.1.10",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.18",
    "@types/bcryptjs": "2.4.6",
    "@types/better-sqlite3": "7.6.12",
    "@types/cookie-session": "2.0.49",
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.6",
    "@types/node": "22.13.10",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "prettier": "3.5.3",
    "supertest": "7.3.1",
    "tailwindcss": "4.1.18",
    "tsx": "4.23.15",
    "typescript": "5.8.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
