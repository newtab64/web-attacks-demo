<div class="auth">
  <div class="aside">
    <h2><%= i18n.auth.asideTitle %></h2>
    <p><%= i18n.auth.asideDesc %></p>
  </div>

  <form class="form" action="/register" method="POST">
    <h1><%= i18n.auth.registerTitle %></h1>

    <%- include('../partials/flash') %>

    <div class="field">
      <label for="username"><%= i18n.auth.username %></label>
      <input id="username" name="username" autocomplete="username" required>
    </div>

    <div class="field">
      <label for="email"><%= i18n.auth.email %></label>
      <input id="email" name="email" type="email" autocomplete="email" required>
    </div>

    <div class="field">
      <label for="password"><%= i18n.auth.password %></label>
      <input id="password" name="password" type="password" autocomplete="new-password" required>
    </div>

    <button class="btn block" type="submit"><%= i18n.auth.submitRegister %></button>

    <p class="alt">
      <%= i18n.auth.hasAccount %> <a href="/login"><%= i18n.auth.loginTitle %></a>
    </p>
  </form>
</div>
