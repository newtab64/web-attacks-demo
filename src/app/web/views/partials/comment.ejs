<div class="comment" id="comment-<%= comment.id %>" data-testid="comment-item">
  <span class="av b"><%= comment.author_name ? comment.author_name.substring(0, 2).toUpperCase() : 'ND' %></span>
  <div>
    <div class="head">
      <strong><%= comment.author_name %></strong>
      <span><%= comment.relative_time || comment.created_at %></span>
    </div>
    <p>
      <% if (!isSecure) { %><%- comment.content %><% } else { %><%= comment.content %><% } %>
    </p>
  </div>
</div>
