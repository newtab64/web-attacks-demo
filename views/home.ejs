<%- include('layout/header') %>

<section>
  <h1 style="margin-bottom: 20px; font-size: 1.8rem;">Recent Community Posts</h1>

  <% if (posts.length === 0) { %>
    <p style="color: var(--text-muted);">No posts available yet.</p>
  <% } else { %>
    <% posts.forEach(post => { %>
      <article class="post-card">
        <h2 class="post-title"><a href="/posts/<%= post.id %>"><%= post.title %></a></h2>
        <div class="post-meta">By <%= post.author_name %> &bull; <%= post.created_at %></div>
        <p class="post-content"><%= post.content.substring(0, 160) %>...</p>
      </article>
    <% }); %>
  <% } %>
</section>

<%- include('layout/footer') %>
