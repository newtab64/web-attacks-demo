<%- include('layout/header') %>

<article class="post-card" style="margin-top: 10px;">
  <h1 class="post-title" style="font-size: 2rem; margin-bottom: 10px;"><%= post.title %></h1>
  <div class="post-meta">By <%= post.author_name %> &bull; <%= post.created_at %></div>
  <div class="post-content" style="margin-top: 18px; line-height: 1.8;"><%= post.content %></div>
</article>

<section class="comments-section">
  <h2 style="font-size: 1.4rem; margin-bottom: 16px;">Comments (<%= comments.length %>)</h2>

  <% if (comments.length === 0) { %>
    <p style="color: var(--text-muted); margin-bottom: 20px;">No comments yet. Be the first to reply!</p>
  <% } else { %>
    <% comments.forEach(comment => { %>
      <div class="comment-card">
        <div class="comment-meta"><%= comment.author_name %> &bull; <%= comment.created_at %></div>
        <div class="comment-body">
          <% if (!secure) { %><%- comment.content %><% } else { %><%= comment.content %><% } %>
        </div>
      </div>
    <% }); %>
  <% } %>

  <div class="form-card" style="max-width: 100%; margin: 24px 0 0 0;">
    <h3 style="font-size: 1.2rem; margin-bottom: 14px;">Leave a Comment</h3>
    <form action="/posts/<%= post.id %>/comments" method="POST">
      <div class="form-group">
        <label for="author_name">Your Name</label>
        <input type="text" id="author_name" name="author_name" required value="<%= user ? user.username : '' %>">
      </div>
      <div class="form-group">
        <label for="content">Comment</label>
        <textarea id="content" name="content" rows="4" required></textarea>
      </div>
      <button type="submit" class="btn">Post Comment</button>
    </form>
  </div>
</section>

<%- include('layout/footer') %>
